<!doctype html>
<html>
  <body style="font-family: Arial, sans-serif; color: #111827;">
    <h2>Social Post Failed</h2>
    <p>Hello <%= userName %>,</p>
    <p>
      A scheduled social post could not be published. Please review the details
      below and retry after reconnecting your account if needed.
    </p>
    <ul>
      <li><strong>Property ID:</strong> <%= propertyId %></li>
      <li><strong>Property:</strong> <%= propertyTitle %></li>
      <li><strong>Address:</strong> <%= propertyAddress %></li>
      <li><strong>Platform:</strong> <%= platform %></li>
      <li><strong>Target ID:</strong> <%= targetId %></li>
      <li><strong>Scheduled For:</strong> <%= scheduledFor %></li>
      <li><strong>Error:</strong> <%= errorMessage %></li>
    </ul>
    <p><strong>Post content:</strong></p>
    <p><%= caption %></p>
    <p>Regards,<br />PropAI Team</p>
  </body>
</html>

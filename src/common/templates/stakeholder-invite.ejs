<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Property Invitation</title>
    <style>
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            line-height: 1.6;
            color: #1a1a1a;
            margin: 0;
            padding: 0;
            background-color: #f9fafb;
        }
        .container {
            max-width: 600px;
            margin: 40px auto;
            background: #ffffff;
            border-radius: 24px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
            border: 1px solid #f1f5f9;
        }
        .header {
            background: #3525CD;
            padding: 48px 40px;
            text-align: center;
        }
        .header h1 {
            color: #ffffff;
            margin: 0;
            font-size: 28px;
            font-weight: 800;
            letter-spacing: -0.02em;
        }
        .content {
            padding: 48px 40px;
        }
        .welcome-text {
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 24px;
            color: #111827;
        }
        .property-card {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            padding: 24px;
            margin: 32px 0;
        }
        .property-title {
            font-size: 20px;
            font-weight: 800;
            color: #3525CD;
            margin-bottom: 8px;
        }
        .property-id {
            font-size: 13px;
            color: #64748b;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
        .credentials-box {
            background: #fffbeb;
            border: 1px solid #fef3c7;
            border-radius: 16px;
            padding: 24px;
            margin: 32px 0;
        }
        .label {
            font-size: 12px;
            font-weight: 800;
            color: #92400e;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 4px;
        }
        .value {
            font-family: 'JetBrains Mono', 'Courier New', monospace;
            font-size: 16px;
            font-weight: 700;
            color: #1a1a1a;
            margin-bottom: 16px;
        }
        .cta-button {
            display: inline-block;
            background: #3525CD;
            color: #ffffff !important;
            text-decoration: none;
            padding: 16px 32px;
            border-radius: 12px;
            font-weight: 800;
            font-size: 15px;
            text-align: center;
            margin-top: 24px;
            transition: all 0.2s;
        }
        .secondary-link {
            display: inline-block;
            color: #3525CD;
            text-decoration: none;
            font-weight: 700;
            font-size: 14px;
            margin-top: 16px;
        }
        .footer {
            padding: 32px 40px;
            background: #f8fafc;
            text-align: center;
            border-top: 1px solid #f1f5f9;
        }
        .footer p {
            font-size: 13px;
            color: #64748b;
            margin: 0;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>PropAI Invitation</h1>
        </div>
        <div class="content">
            <p class="welcome-text">Hello <%= recipientName %>,</p>
            <p>You have been invited to collaborate as a <strong><%= role %></strong> on a property transaction via <strong>PropAI</strong>. Our platform ensures a seamless, secure, and transparent closing process.</p>

            <div class="property-card">
                <div class="property-id"><%= role %> Role</div>
                <div class="property-title"><%= propertyTitle %></div>
                <p style="margin: 0; font-size: 14px; color: #64748b;">Property ID: #<%= propertyId %></p>
                <a href="<%= propertyPublicUrl %>" class="secondary-link">View Public Listing →</a>
            </div>

            <% if (!isExistingUser && tempPassword) { %>
                <div class="credentials-box">
                    <p style="margin-top: 0; font-weight: 700; color: #92400e;">Access Credentials</p>
                    <div class="label">Your Email</div>
                    <div class="value"><%= recipientEmail %></div>
                    <div class="label">Temporary Password</div>
                    <div class="value"><%= tempPassword %></div>
                    <p style="margin-bottom: 0; font-size: 13px; color: #b45309;">Please change your password after your first login.</p>
                </div>
            <% } else { %>
                <div class="credentials-box" style="background: #f0fdf4; border-color: #dcfce7;">
                    <p style="margin: 0; font-weight: 700; color: #166534;">You already have an account with us. Use your existing credentials to log in and access this property.</p>
                </div>
            <% } %>

            <div style="text-align: center;">
                <a href="<%= loginUrl %>" class="cta-button">Log In to Dashboard</a>
            </div>
        </div>
        <div class="footer">
            <p>© 2024 PropAI. All rights reserved.</p>
            <p>Professional Property Management Simplified.</p>
        </div>
    </div>
</body>
</html>
